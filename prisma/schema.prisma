generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       String?
  features    String[] @default([])
  imageUrl    String?
  images      String[] @default([])  // <-- BU SATIR OLMALI!
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Product")
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int      @default(5)
  date      String
  text      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Settings {
  id            String   @id @default("main")
  whatsapp      String   @default("905353969768")
  phone         String   @default("0535 396 97 68")
  email         String   @default("balcioglumakina@gmail.com")
  address       String   @default("Barbaros, 163. Sk No:5 Kat:3, 34165 Bağcılar/İstanbul")
  contactPerson String   @default("Ekrem BALCI")
  mapsLink      String   @default("https://www.google.com/maps/place/K%C4%B1l%C3%A7%C4%B1k+Makinesi")
  heroTitle     String   @default("Kılçık Makinesi ve Sabitleme Sistemlerinde Güvenilir Çözüm Ortağınız")
  heroSubtitle  String   @default("2006 yılından bu yana imalat, ithalat, ihracat ve pazarlama alanlarında sektörün öncüsü")
  updatedAt     DateTime @updatedAt
}