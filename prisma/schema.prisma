generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       String?
  features    String[] @default([])
  imageUrl    String?
  images      String[] @default([])
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("Product")
}

model Analytics {
  id          String   @id @default(cuid())
  type        String
  url         String?
  productId   String?
  deviceType  String?
  ip          String?
  duration    Int?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int      @default(5)
  date      String
  text      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Settings {
  id                String   @id @default(cuid())
  siteTitle         String   @default("Balcıoğlu Makina")
  phone             String   @default("0535 396 97 68")
  address           String   @default("Barbaros, 163. Sk No:5 Kat:3, 34165 Bağcılar/İstanbul")
  email             String   @default("balcioglumakina@gmail.com")
  instagramUrl      String   @default("#")
  facebookUrl       String   @default("#")
  linkedinUrl       String   @default("#")
  youtubeUrl        String   @default("#")
  heroText          String   @default("2006'dan beri kılçık makinesi ve sabitleme sistemlerinde güvenilir çözüm ortağınız.")
  metaDescription   String   @default("Kılçık makinesi ve sabitleme sistemleri")
  googleAnalyticsId String   @default("")
  maintenanceMode   Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}